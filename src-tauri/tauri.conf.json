{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exero",
  "version": "0.4.0-Beta9",
  "identifier": "com.exero.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm.CMD dev",
    "beforeBuildCommand": "pnpm.CMD build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Exero",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "devtools": true,
        "center": true,
        "visible": true
      },
      {
        "label": "tray-menu",
        "title": "Exero Tray",
        "width": 160,
        "height": 114,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "devtools": false,
        "center": false,
        "visible": false,
        "url": "tray-menu.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["exero"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Exero",
    "category": "Utility",
    "shortDescription": "个人自动化助手",
    "longDescription": "Exero - 基于 Tauri + Rust 的 Windows 桌面自动化管理工具",
    "copyright": "MIT License © 2026 Exero",
    "resources": [
      "../CHANGELOG.md",
      "../LICENSE",
      "resources/monitor/NexBoxMonitor.exe",
      "resources/monitor/NexBoxMonitor.exe.config",
      "resources/monitor/LibreHardwareMonitorLib.dll",
      "resources/monitor/HidSharp.dll",
      "resources/monitor/System.Buffers.dll",
      "resources/monitor/System.Memory.dll",
      "resources/monitor/System.Numerics.Vectors.dll",
      "resources/monitor/System.Runtime.CompilerServices.Unsafe.dll",
      "resources/monitor/System.Text.Json.dll",
      "resources/monitor/System.Text.Encodings.Web.dll",
      "resources/monitor/System.Threading.Tasks.Extensions.dll",
      "resources/monitor/Microsoft.Bcl.AsyncInterfaces.dll",
      "resources/monitor/System.ValueTuple.dll"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
