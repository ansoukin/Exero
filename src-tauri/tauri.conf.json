{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Exero",
  "version": "0.4.0-Beta3",
  "identifier": "com.exero.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm.CMD dev",
    "beforeBuildCommand": "pnpm.CMD build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Exero",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Exero",
    "category": "Utility",
    "shortDescription": "个人自动化助手",
    "longDescription": "Exero - 基于 Tauri + Rust 的 Windows 桌面自动化管理工具",
    "copyright": "MIT License © 2026 Exero",
    "resources": [
      "../CHANGELOG.md",
      "../LICENSE"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
