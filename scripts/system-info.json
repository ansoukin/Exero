{
    "id": "system-info",
    "name": "系统时间",
    "author": "Exero",
    "version": "1.0.0",
    "description": "os 库演示：格式化当前系统时间，支持 short/full 两种格式。严格沙箱下 os.date/os.time/os.clock 可正常使用。",
    "permissions": [],
    "params": [
        {
            "name": "format",
            "label": "时间格式",
            "type": "select",
            "default": "short",
            "options": ["short", "full"],
            "required": false
        }
    ]
}
