{
  "id": "lua-scripts-pack",
  "version": "1.1.0",
  "name": "基础 Lua 动作包",
  "description": "Exero 官方示例 Lua 动作集合：Hello World、计数器、系统时间。演示 args 参数读取、exero.log/notify/set_result API、变量系统、os 库等基础能力。",
  "author": "Exero",
  "exero_api_version": "0.4.0",
  "pack_type": "action",
  "actions": [
    {
      "id": "hello-world",
      "executor_type": "Lua",
      "executor_id": "scripts/hello-world.lua",
      "label": "Hello World",
      "category": "lua",
      "icon": "Code",
      "default_params": { "name": "World" },
      "ports": {
        "inputs": [{ "id": "trigger", "position": "top", "label": "触发" }],
        "outputs": [{ "id": "done", "position": "bottom", "label": "完成" }]
      },
      "summarize_template": "Hello {name}",
      "description": "最简入门示例：演示 args 参数读取、exero.log/notify/set_result 三大基础 API。",
      "permissions": [],
      "params": [
        {
          "name": "name",
          "label": "称呼",
          "type": "string",
          "default": "World",
          "options": [],
          "required": false
        }
      ]
    },
    {
      "id": "counter",
      "executor_type": "Lua",
      "executor_id": "scripts/counter.lua",
      "label": "计数器",
      "category": "lua",
      "icon": "Hash",
      "default_params": { "increment": 1, "reset": false },
      "ports": {
        "inputs": [{ "id": "trigger", "position": "top", "label": "触发" }],
        "outputs": [{ "id": "done", "position": "bottom", "label": "完成" }]
      },
      "summarize_template": "计数器 +{increment}",
      "description": "变量系统演示：使用全局变量 counter 跨动作链累加，支持 reset 参数重置。演示 exero.get_var/set_var 的 global 模式。",
      "permissions": [],
      "params": [
        {
          "name": "increment",
          "label": "增量",
          "type": "number",
          "default": 1,
          "options": [],
          "required": false
        },
        {
          "name": "reset",
          "label": "重置计数器",
          "type": "boolean",
          "default": false,
          "options": [],
          "required": false
        }
      ]
    },
    {
      "id": "system-info",
      "executor_type": "Lua",
      "executor_id": "scripts/system-info.lua",
      "label": "系统时间",
      "category": "lua",
      "icon": "Clock",
      "default_params": { "format": "short" },
      "ports": {
        "inputs": [{ "id": "trigger", "position": "top", "label": "触发" }],
        "outputs": [{ "id": "done", "position": "bottom", "label": "完成" }]
      },
      "summarize_template": "{format}",
      "description": "os 库演示：格式化当前系统时间，支持 short/full 两种格式。严格沙箱下 os.date/os.time/os.clock 可正常使用。",
      "permissions": [],
      "params": [
        {
          "name": "format",
          "label": "时间格式",
          "type": "select",
          "default": "short",
          "options": ["short", "full"],
          "required": false
        }
      ]
    }
  ]
}
