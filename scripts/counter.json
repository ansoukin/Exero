{
    "id": "counter",
    "name": "计数器",
    "author": "Exero",
    "version": "1.0.0",
    "description": "变量系统演示：使用全局变量 counter 跨动作链累加，支持 reset 参数重置。演示 exero.get_var/set_var 的 global 模式。",
    "permissions": [],
    "params": [
        {
            "name": "increment",
